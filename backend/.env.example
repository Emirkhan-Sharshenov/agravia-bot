# Какой LLM-провайдер использовать: groq (бесплатно, по умолчанию для
# разработки) | gigachat (бесплатно, согласованный Вариант B) | anthropic (платно)
#
# ВАЖНО (раздел 13.3 ТЗ "AI-бот AGRAVIA 2027"): Groq и Anthropic — зарубежные
# AI API, отправка туда пользовательских сообщений запрещена без отдельного
# согласования. Groq стоит по умолчанию здесь для удобства локальной
# разработки/демо (не нужен сертификат НУЦ Минцифры). Перед production —
# переключитесь на LLM_PROVIDER=gigachat (согласованный Вариант B, раздел
# 13.2 ТЗ) либо на локальную LLM (Вариант A, раздел 13.1 ТЗ).
LLM_PROVIDER=groq

# --- Groq — провайдер по умолчанию для разработки, бесплатный и без сертификатов ---
# Получить ключ: https://console.groq.com/keys
GROQ_API_KEY=
# llama-3.1-8b-instant / llama-3.3-70b-versatile — Enterprise-only на обычных
# ключах (404 model_not_found). Актуальный список: console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

# --- GigaChat (Сбер) — согласованный провайдер для production (Вариант B) ---
# Также используется для embeddings/семантического поиска (см. retrieval.py)
# НЕЗАВИСИМО от выбранного LLM_PROVIDER — если ключ задан, поиск семантический
# даже при LLM_PROVIDER=groq (у Groq своего embeddings API нет).
# Получить: https://developers.sber.ru -> личный кабинет -> GigaChat API -> "Создать проект"
# -> вкладка "Получить доступ" -> Authorization key (это готовая Base64-строка client_id:client_secret)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Для запросов к GigaChat нужен сертификат НУЦ Минцифры (см. README, раздел
# "Сертификат для GigaChat"). Пока не установили — можно временно поставить
# false, но это отключает проверку SSL и не годится для продакшена.
GIGACHAT_VERIFY_SSL=true

# --- Anthropic (Claude) — опциональная платная альтернатива ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Уведомления менеджеру в Telegram (необязательно) ---
# Без них заявки всё равно сохраняются в backend/logs/handoffs.jsonl
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# --- Параметры Groq ---
# На бесплатном тарифе Groq лимит 8000 токенов/мин на модель — этого хватает
# примерно на 2 диалоговых хода в минуту (каждый ход = 2 вызова LLM: определение
# темы/роли + ответ). Для реальной нагрузки нужен платный Dev Tier Groq либо
# другой провайдер (GigaChat). При 429 бэкенд ждёт указанное в ошибке время
# (не больше RATE_LIMIT_MAX_WAIT секунд на вызов) и повторяет запрос.
# GROQ_REASONING_EFFORT=low
# RATE_LIMIT_MAX_WAIT=9

# --- Поиск фактов внутри темы (retrieval.py) ---
# Порог "по этому вопросу в базе ничего нет" для вопросов вне размеченных тем
# (intent "other"); для embeddings и для fuzzy-fallback разные. Калибруется
# на тестовом наборе (раздел 21 ТЗ v1 / QA-набор ТЗ v2).
# SEMANTIC_LOW_THRESHOLD=0.55
# FUZZY_LOW_THRESHOLD=0.62
# Сколько прошлых реплик пользователя учитывать при ранжировании фактов и
# с каким весом текущее сообщение важнее контекста:
# CONTEXT_TURNS=2
# CURRENT_MESSAGE_WEIGHT=0.75
