# Какой LLM-провайдер использовать: gigachat (бесплатно, по умолчанию) | anthropic (платно)
LLM_PROVIDER=gigachat

# --- GigaChat (Сбер) — провайдер по умолчанию, бесплатный лимит 1 млн токенов/мес ---
# Получить: https://developers.sber.ru -> личный кабинет -> GigaChat API -> "Создать проект"
# -> вкладка "Получить доступ" -> Authorization key (это готовая Base64-строка client_id:client_secret)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Для запросов к GigaChat нужен сертификат НУЦ Минцифры (см. README, раздел
# "Сертификат для GigaChat"). Пока не установили — можно временно поставить
# false, но это отключает проверку SSL и не годится для продакшена.
GIGACHAT_VERIFY_SSL=true

# --- Anthropic (Claude) — опциональная платная альтернатива ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Уведомления менеджеру в Telegram (необязательно) ---
# Без них заявки всё равно сохраняются в backend/logs/handoffs.jsonl
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# --- Пороги confidence и контекста (раздел 11 ТЗ AI-бот AGRAVIA 2027) ---
# Дефолты ниже ориентировочные (см. комментарии в backend/retrieval.py).
# ТЗ прямо требует откалибровать их по результатам тестового набора не
# менее чем из 200 вопросов (раздел 21 ТЗ) перед запуском в продакшен —
# НЕ оставляйте дефолты "на глаз".
#
# Пороги для semantic search (используются, когда настроен GIGACHAT_AUTH_KEY
# и embeddings доступны):
# SEMANTIC_HIGH_THRESHOLD=0.78
# SEMANTIC_LOW_THRESHOLD=0.55
#
# Пороги для fuzzy-fallback (используются без embeddings — только для
# локальной разработки без ключа, менее точны, см. retrieval.py):
# FUZZY_HIGH_THRESHOLD=0.72
# FUZZY_LOW_THRESHOLD=0.54
#
# Насколько близко должны быть скоры visitor/exhibitor, чтобы считать роль
# пользователя неоднозначной и задать уточняющий вопрос (раздел 4.4 ТЗ):
# ROLE_AMBIGUITY_MARGIN=0.08
#
# Сколько последних реплик пользователя учитывать при поиске (раздел 5 ТЗ)
# и с каким весом текущее сообщение важнее контекста:
# CONTEXT_TURNS=2
# CURRENT_MESSAGE_WEIGHT=0.75
